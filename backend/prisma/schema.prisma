// ── ÖZEL SİPARİŞ ─────────────────────────────────────────────────
model OzelSiparis {
  id                String   @id @default(cuid())

  // Müşteri bilgileri
  musteriAdi        String
  musteriTelefon    String?
  musteriId         String?  // POS müşteri ID

  // Satış bağlantısı
  satisSiparisId    String?  // POS satış siparişi ID
  saleItemId        String?  // POS satış kalemi ID (mükerrer sipariş kontrolü)
  subeId            String?
  subeAdi           String?
  sirketId          Int?

  // Ürün bilgileri
  tip               String   // RECETELI | STANDART
  urunAdi           String
  urunKodu          String?
  miktar            Int      @default(1)

  // Reçete bilgileri (tip=RECETELI ise)
  sagSph            Float?
  sagCyl            Float?
  sagAks            Float?
  sagAdd            Float?
  sagPd             Float?
  solSph            Float?
  solCyl            Float?
  solAks            Float?
  solAdd            Float?
  solPd             Float?
  camTipi           String?  // TEK_ODAKLI | PROGRESIF | BIFOCAL
  camIndeksi        String?  // 1.50 | 1.60 | 1.67 | 1.74
  kaplama           String?  // AR | BLUE_CUT | FOTOKROMIK | SEFFAF
  cerceveBilgisi    String?

  // Tedarikçi bilgileri
  tedarikciId       Int?     // Odoo partner ID
  tedarikciAdi      String?
  tedarikciSiparisNo String?

  // Fiyat bilgileri
  tahminiMaliyet    Float?
  satisFiyati       Float?

  // Durum takibi
  durum             String   @default("BEKLIYOR")
  // BEKLIYOR | GONDERILDI | URETIMDE | KARGODA | TESLIM_ALINDI | LABORATUVARDA | HAZIR | TESLIM_EDILDI | IPTAL
  // (eski: TEDARIKCIE_GONDERILDI → GONDERILDI, MUSTERIYE_TESLIM → TESLIM_EDILDI)

  olusturanUserId   String?

  notlar            String?
  olcumBilgisi      Json?    // LensOrderMeasurement[]
  tahminiGelisTarihi DateTime?
  gercekGelisTarihi  DateTime?
  teslimTarihi      DateTime?

  olusturanKullanici String?

  firmaUrunu        String?
  satisTemsilcisi   String?

  // Garanti/reçete kartı (ZC100 kart yazıcı) basım takibi
  kartBasildi       Boolean  @default(false)
  kartBasmaTarihi   DateTime?

