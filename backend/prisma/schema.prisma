  tedarikciVkn String?  @unique
  tedarikciAdi String?
  kolonMap     String   // JSON: { stokKodu: "stokKodu", urunAdi: "urunAdi", ... }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tedarikciAdi])
}

enum WarrantyStatus {
  OPEN
  SENT_TO_SUPPLIER
  WAITING_RESPONSE
  IN_RETURN_PROCESS
  RESOLVED
  OUT_OF_WARRANTY
}

enum WarrantyResult {
  PENDING
  NEW_PRODUCT
  PART_FREE
  PART_PAID
  POINTS_LOADED
  OUT_OF_WARRANTY_FEE
  OUT_OF_WARRANTY_REJECTED
  REFUNDED
  RESTOCKED
}

enum TransferStatus {
  NOT_REQUIRED
  PENDING
  COMPLETED
}

enum WarrantyType {
  CUSTOMER_WARRANTY
  STOCK_WARRANTY
  SATISFACTION_RETURN
  EXCESS_ORDER_RETURN
}

enum WarrantyExpectedOutcome {
  UNKNOWN
  NEW_PRODUCT
  REPAIR
  POINTS
  REFUND
}

model WarrantyClaim {
  id              String    @id @default(uuid())
  claimNo         String    @unique
  status          WarrantyStatus @default(OPEN)
  result          WarrantyResult @default(PENDING)
  type            WarrantyType
  expectedOutcome WarrantyExpectedOutcome @default(UNKNOWN)

  saleId          String?
  sale            Sale?     @relation(fields: [saleId], references: [id])
  saleItemId      String?
  saleItem        SaleItem? @relation(fields: [saleItemId], references: [id])

  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])

  branchId        String?
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])

  productName     String?
  productCategory String?
  odooCategoryId  Int?
  lotNo           String?
  barcode         String?
  internalRef     String?
  supplierName    String?

  chainJson       String?

  problemDesc     String?
  supplierNote      String?
  returnBranchId    String?
  supplierId        String?
  returnDeadline    DateTime?
  cargoTrackingNo   String?
  adminApprovedAt   DateTime?
  adminApprovedBy   String?

  transferSourceBranchId String?
  transferStatus         TransferStatus? @default(NOT_REQUIRED)
  odooPickingId          String?

  managerApprovedAt      DateTime?
  managerApprovedBy      String?

  refundAmount           Decimal?  @db.Decimal(10, 2)
  refundMethod           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages        WarrantyMessage[]
}

model WarrantyMessage {
  id        String   @id @default(uuid())
  claimId   String
  claim     WarrantyClaim @relation(fields: [claimId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  message   String
  createdAt DateTime @default(now())
}

