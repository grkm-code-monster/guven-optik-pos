  isDeneyimleri       Json? // [{firmaAdi, gorevi, baslangic, ayrilis, ayrilisNedeni, isTanimi}]
  yabanciDiller       Json? // [{dil, okuma, yazma, konusma}]
  bilgisayarBilgileri Json? // [{program, seviye}]
  referanslar         Json? // [{adSoyad, firma, gorevi, telefon, yakinlikDerecesi}]

