generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  name       String
  username   String   @unique
  pin        String // bcrypt hash
  role       Role
  branchId   String
  isActive   Boolean  @default(true)
  odooEmployeeId  Int?      // hr.employee.id
  personelId      String?   @unique // Personel.id FK
  createdAt  DateTime @default(now())
  branch     Branch   @relation(fields: [branchId], references: [id])
  personel        Personel? @relation("UserPersonelLink", fields: [personelId], references: [id])
  personelByUser  Personel? @relation("PersonelUserLink")
  sales      Sale[]
  shifts     Shift[]
  warrantyClaims   WarrantyClaim[]
  warrantyMessages WarrantyMessage[]
  gorevliler           Gorevli[] @relation("GorevliUser")
  atadigiGorevliler    Gorevli[] @relation("GorevliAtayan")
  yedekSorumluSubeler  Branch[]  @relation("BranchYedekSorumlu")
}

enum Role {
  SALES_STAFF
  STORE_MANAGER
  REGIONAL_MANAGER
  ACCOUNTANT
  ADMIN
}

model Branch {
  id              String    @id @default(uuid())
  name            String
  code            String    @unique
  isActive        Boolean   @default(true)
  sirketId        Int?
  sirketAdi       String?
  vkn             String?
  odooLocationId  Int?
  pdksPlaceId     Int?
  uyumsoftUser    String?
  uyumsoftPass    String?
  adres           String?
  telefon         String?
  yedekSorumluId  String?
  users           User[]
  yedekSorumlu    User?     @relation("BranchYedekSorumlu", fields: [yedekSorumluId], references: [id])
  gorevliler      Gorevli[]
  utsSube         UtsSube?
  utsBildirimler  UtsBildirim[]
}

model Gorevli {
  id          String   @id @default(cuid())
  branchId    String
  userId      String
  atayaUserId String
  tarih       DateTime @db.Date
  baslangic   String?
  bitis       String?
  notlar      String?
  aktif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  branch      Branch   @relation(fields: [branchId], references: [id])
  user        User     @relation("GorevliUser", fields: [userId], references: [id])
  atayan      User     @relation("GorevliAtayan", fields: [atayaUserId], references: [id])
}

model Customer {
  id               String    @id @default(uuid())
  name             String
  phone            String    @unique
  note             String?
  // V2 alanları — şimdi ekle, V2'de aktive et
  identityNo       String?
  birthDate        DateTime?
  sgkType          String?
  medulaNo         String?
  doctorName       String?
  prescriptionNo   String?
  hasPresciption   Boolean   @default(false)
  // Daimi
  far_r_pd         String?
  far_r_sph        String?
  far_r_cyl        String?
  far_r_aks        String?
  far_r_diagnosis  String?
  far_l_pd         String?
  far_l_sph        String?
  far_l_cyl        String?
  far_l_aks        String?
  far_l_diagnosis  String?
  // Yakın
  near_r_pd        String?
  near_r_sph       String?
  near_r_cyl       String?
  near_r_aks       String?
  near_r_diagnosis String?
  near_l_pd        String?
  near_l_sph       String?
  near_l_cyl       String?
  near_l_aks       String?
  near_l_diagnosis String?
  // Lens
  lens_r_bc        String?
  lens_r_sph       String?
  lens_r_cyl       String?
  lens_r_aks       String?
  lens_r_add       String?
  lens_l_bc        String?
  lens_l_sph       String?
  lens_l_cyl       String?
  lens_l_aks       String?
  lens_l_add       String?
  // E-Reçete
  eRx_no           String?
  eRx_date         String?
  eRx_hospital     String?
  eRx_doctor       String?
  eRx_diagnosis    String?
  odooPartnerId    Int?
  createdAt        DateTime  @default(now())
  sales            Sale[]
  prescriptions    CustomerPrescription[]
  warrantyClaims   WarrantyClaim[]
}

model CustomerPrescription {
  id            String   @id @default(uuid())
  customerId    String
  date          DateTime @default(now())
  source        String   @default("MANUAL")

  far_r_pd   String?
  far_r_sph  String?
  far_r_cyl  String?
  far_r_aks  String?
  far_r_note String?
  far_l_pd   String?
  far_l_sph  String?
  far_l_cyl  String?
  far_l_aks  String?
  far_l_note String?

  near_r_pd   String?
  near_r_sph  String?
  near_r_cyl  String?
  near_r_aks  String?
  near_r_note String?
  near_l_pd   String?
  near_l_sph  String?
  near_l_cyl  String?
  near_l_aks  String?
  near_l_note String?

  lens_r_bc   String?
  lens_r_sph  String?
  lens_r_cyl  String?
  lens_r_aks  String?
  lens_r_add  String?
  lens_r_note String?
  lens_l_bc   String?
  lens_l_sph  String?
  lens_l_cyl  String?
  lens_l_aks  String?
  lens_l_add  String?
  lens_l_note String?

  eRx_no        String?
  eRx_date      String?
  eRx_hospital  String?
  eRx_doctor    String?
  eRx_diagnosis String?

  createdAt DateTime @default(now())
  customer  Customer @relation(fields: [customerId], references: [id])
}

model Product {
  id          String          @id @default(uuid())
  barcode     String?         @unique
  name        String
  productType ProductType     // READY veya PRESCRIBED
  category    ProductCategory // Ana kategori
  subCategory String?         // Alt kategori (serbest metin)
  group       ProductGroup?   // Fiyat/rapor grubu
  price       Decimal         @db.Decimal(10, 2)
  taxRate     Decimal         @db.Decimal(5, 2) @default(20)
  brand       String?         // Marka
  model       String?         // Model
  isActive    Boolean         @default(true)
  odooId      String?
  saleItems   SaleItem[]
}

enum ProductType {
  READY
  PRESCRIBED
}

enum ProductCategory {
  SUNGLASSES_READY
  OPTICAL_FRAME_READY
  CONTACT_LENS_READY
  SOLUTION
  ACCESSORY

  SUNGLASSES_RX
  OPTICAL_FRAME_RX
  LENS_RX
  CONTACT_LENS_RX
}

enum ProductGroup {
  UPPER
  UPPER_MID
  MID
  LOWER

  PROGRESSIVE_UPPER
  PROGRESSIVE_UPPER_MID
  PROGRESSIVE_MID
  PROGRESSIVE_LOWER
  OFFICE_LENS
  SPECIAL_LENS
  SINGLE_CUSTOM
  SINGLE_NON_STOCK
  SINGLE_STOCK

  CONTACT_SPH
  CONTACT_DAILY
  CONTACT_TORIC
  CONTACT_MULTIFOCAL
  CONTACT_COLORED_RX
}

model Sale {
  id                 String     @id @default(uuid())
  customerId         String
  userId             String // satışı yapan personel
  branchId           String
  shiftId            String
  grossTotal         Decimal    @db.Decimal(10, 2)
  discountTotal      Decimal    @db.Decimal(10, 2) @default(0)
  netTotal           Decimal    @db.Decimal(10, 2)
  taxTotal           Decimal    @db.Decimal(10, 2)
  status             SaleStatus @default(DRAFT)
  // VOID alanları
  voidReason         String?
  voidUserId         String?
  voidAt             DateTime?
  // V2 SGK alanları — şimdi ekle
  prescriptionAmount Decimal?   @db.Decimal(10, 2)
  sgkAmount          Decimal?   @db.Decimal(10, 2)
  // Odoo sync
  odooSaleId         String?
  syncStatus         SyncStatus @default(PENDING)
  syncError          String?
  odooSaleOrderId    Int?
  odooSynced         Boolean    @default(false)
  odooSyncError      String?
  eFaturaId          String?
  eFaturaDurum       String?    // GONDERILDI, BEKLIYOR, HATA
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  shift    Shift    @relation(fields: [shiftId], references: [id])
  items    SaleItem[]
  payments Payment[]
  warrantyClaims WarrantyClaim[]
}

enum SaleStatus {
  DRAFT
  PAID
  ORDERED
  IN_LAB
  READY
  DELIVERED
  VOID
}

enum SyncStatus {
  PENDING
  SYNCED
  ERROR
  CONFLICT
}

model SaleItem {
  id              String  @id @default(uuid())
  saleId          String
  productId       String
  odooCategoryId  Int?
  odooProductId   String?
  odooProductName String?
  lotNo           String?
  qty             Int     @default(1)
  unitPrice       Decimal @db.Decimal(10, 2)
  discount        Decimal @db.Decimal(10, 2) @default(0)
  taxAmount       Decimal @db.Decimal(10, 2)
  lineTotal       Decimal @db.Decimal(10, 2)

  linkedItemId String?
  linkType     LinkType?

  prescription Prescription?
  frames       Frame[]

  status ItemStatus @default(PENDING)
  deliveryDate  DateTime?

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  warrantyClaims WarrantyClaim[]
}

enum LinkType {
  FRAME_LENS
  CUSTOMER_FRAME
}

enum ItemStatus {
  PENDING
  ORDERED
  IN_LAB
  READY
  DELIVERED
  VOID
}

model Prescription {
  id               String             @id @default(uuid())
  saleItemId       String             @unique
  prescriptionType PrescriptionType

  r_pd   Decimal? @db.Decimal(5, 2)
  r_sph  Decimal? @db.Decimal(5, 2)
  r_cyl  Decimal? @db.Decimal(5, 2)
  r_aks  Int?
  r_add  Decimal? @db.Decimal(5, 2)

  l_pd   Decimal? @db.Decimal(5, 2)
  l_sph  Decimal? @db.Decimal(5, 2)
  l_cyl  Decimal? @db.Decimal(5, 2)
  l_aks  Int?
  l_add  Decimal? @db.Decimal(5, 2)

  near_r_sph Decimal? @db.Decimal(5, 2)
  near_l_sph Decimal? @db.Decimal(5, 2)

  lens_r_sph   Decimal? @db.Decimal(5, 2)
  lens_r_cyl   Decimal? @db.Decimal(5, 2)
  lens_r_aks   Int?
  lens_r_bc    Decimal? @db.Decimal(5, 2)
  lens_r_dia   Decimal? @db.Decimal(5, 2)
  lens_r_add   Decimal? @db.Decimal(5, 2)
  lens_r_color String?
  lens_r_brand String?

  lens_l_sph   Decimal? @db.Decimal(5, 2)
  lens_l_cyl   Decimal? @db.Decimal(5, 2)
  lens_l_aks   Int?
  lens_l_bc    Decimal? @db.Decimal(5, 2)
  lens_l_dia   Decimal? @db.Decimal(5, 2)
  lens_l_add   Decimal? @db.Decimal(5, 2)
  lens_l_color String?
  lens_l_brand String?

  solution    String?
  solutionQty Int?

  prescriptionSource PrescriptionSource @default(MANUAL)
  doctorName         String?
  prescriptionDate   DateTime?
  eReceteCode        String?

  saleItem SaleItem @relation(fields: [saleItemId], references: [id])
}

enum PrescriptionType {
  SINGLE
  PROGRESSIVE
  BIFOCAL
  SUNGLASSES
  CONTACT_LENS
}

enum PrescriptionSource {
  MANUAL
  DOCTOR_RX
  OLD_GLASSES
}

model Frame {
  id        String @id @default(uuid())
  saleItemId String
  sortOrder Int    @default(1)

  barcode String?
  brand   String?
  model   String?

  h          Decimal? @db.Decimal(5, 2)
  cap        Decimal? @db.Decimal(5, 2)
  vertex     Decimal? @db.Decimal(5, 2)
  pantos     Decimal? @db.Decimal(5, 2)
  frameAngle Decimal? @db.Decimal(5, 2)

  saleItem SaleItem @relation(fields: [saleItemId], references: [id])
}
model Payment {
  id               String      @id @default(uuid())
  saleId           String
  paymentType      PaymentType
  bankId           String? // sadece CARD için
  posDeviceId      String? // sadece CARD için
  installment      Int? // taksit sayısı
  grossAmount      Decimal     @db.Decimal(10, 2)
  commissionRate   Decimal?    @db.Decimal(5, 4) // örn: 0.0400
  commissionAmount Decimal?    @db.Decimal(10, 2)
  netAmount        Decimal     @db.Decimal(10, 2)
  createdAt        DateTime    @default(now())
  sale             Sale        @relation(fields: [saleId], references: [id])
}

enum PaymentType {
  CASH
  CARD
  TRANSFER
  OPEN_ACCOUNT
}

model Bank {
  id         String              @id @default(uuid())
  name       String
  isActive   Boolean             @default(true)
  posDevices PosDevice[]
  rates      InstallmentRate[]
}

model PosDevice {
  id       String  @id @default(uuid())
  bankId   String
  branchId String
  name     String
  isActive Boolean @default(true)
  bank     Bank    @relation(fields: [bankId], references: [id])
}

model InstallmentRate {
  id             String    @id @default(uuid())
  bankId         String
  installment    Int // 1, 3, 6, 9, 12
  commissionRate Decimal   @db.Decimal(5, 4) // örn: 0.0400 = %4
  startDate      DateTime
  endDate        DateTime?
  bank           Bank      @relation(fields: [bankId], references: [id])
}

model CashMovement {
  id          String           @id @default(uuid())
  branchId    String
  shiftId     String
  userId      String
  type        CashMovementType
  amount      Decimal          @db.Decimal(10, 2)
  description String
  createdAt   DateTime         @default(now())
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
  ADVANCE
  TRANSFER_OUT
}

model Shift {
  id           String      @id @default(uuid())
  branchId     String
  userId       String // vardiyayı açan kişi
  openCash     Decimal     @db.Decimal(10, 2)
  closeCash    Decimal?    @db.Decimal(10, 2)
  physicalCash Decimal?    @db.Decimal(10, 2) // gün sonu sayılan
  diff         Decimal?    @db.Decimal(10, 2) // fiziki - hesaplanan
  diffReason   String?
  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  user  User   @relation(fields: [userId], references: [id])
  sales Sale[]
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model SyncLog {
  id        String   @id @default(uuid())
  saleId    String?
  action    String // create_order, create_payment, stock_move
  status    String // success, error, conflict
  payload   Json
  response  Json?
  error     String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  payload   Json
  createdAt DateTime @default(now())
}

enum CampaignType {
  KASA
  NAKIT_ORAN
  IKI_AL_BIR_ODE
  URUN_BAZLI
  COMBO
  FORMUL
}

enum CampaignScope {
  ALL
  CATEGORY
  PRODUCT
  CUSTOMER_SEGMENT
}

model Campaign {
  id          String         @id @default(uuid())
  name        String
  description String?
  type        CampaignType
  scope       CampaignScope  @default(ALL)
  scopeValue  String?
  discountPct  Decimal?  @db.Decimal(5, 2)
  discountTL   Decimal?  @db.Decimal(10, 2)
  minBasket    Decimal?  @db.Decimal(10, 2)
  minQty       Int?      @default(0)
  formulMultiplier Decimal? @db.Decimal(8, 4)
  formulExtra      Decimal? @db.Decimal(10, 2)
  formulMargin     Decimal? @db.Decimal(5, 2)
  comboConfig  Json?
  startDate    DateTime?
  endDate      DateTime?
  priority     Int       @default(10)
  autoApply    Boolean   @default(true)
  manualAlso   Boolean   @default(false)
  oodooPricelistId Int?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  branchOverrides CampaignBranchOverride[]
  logs            CampaignLog[]
}

model CampaignBranchOverride {
  id           String    @id @default(uuid())
  campaignId   String
  branchId     String
  branchCode   String
  isActive     Boolean?
  discountPct  Decimal?  @db.Decimal(5, 2)
  discountTL   Decimal?  @db.Decimal(10, 2)
  startDate    DateTime?
  endDate      DateTime?
  autoApply    Boolean?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@unique([campaignId, branchId])
}

model CampaignLog {
  id           String   @id @default(uuid())
  campaignId   String
  saleId       String
  branchId     String
  branchCode   String
  userId       String
  discountTRY  Decimal  @db.Decimal(10, 2)
  appliedAt    DateTime @default(now())
  campaign     Campaign @relation(fields: [campaignId], references: [id])
}

// ── ORTAK ─────────────────────────────────────────────────────────
model Ortak {
  id         String   @id @default(cuid())
  ad         String
  soyad      String?
  telefon    String?
  email      String?
  aktif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  hareketler FinansHareket[]
  varliklar  FinansalVarlik[] @relation("OrtakVarlik")
}

// ── FİNANSAL VARLIK ───────────────────────────────────────────────
model FinansalVarlik {
  id              String   @id @default(cuid())
  ad              String
  tip             String   // BANKA | KASA | POS | ORTAK | CEK | DBS | EK_HESAP
  katman          String   // RESMI | OPERASYONEL
  sirketId        Int?     // Odoo company id
  sirketAdi       String?
  subeId          String?  // Mağaza/şube
  subeAdi         String?
  para_birimi     String   @default("TRY")
  aktif           Boolean  @default(true)
  aciklama        String?
  odooHesapId     Int?     // Odoo account.account id (varsa)
  ortakId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  hareketler      FinansHareket[] @relation("KaynakVarlik")
  hedefHareketler FinansHareket[] @relation("HedefVarlik")
  ortak           Ortak?          @relation("OrtakVarlik", fields: [ortakId], references: [id])
}

// ── FİNANS HAREKETİ ───────────────────────────────────────────────
model FinansHareket {
  id             String   @id @default(cuid())
  tarih          DateTime @default(now())
  tip            String   // TAHSILAT | ODEME | VIRMAN | ORTAK_DESTEGI | ORTAK_ODEME | SIRKET_TRANSFER | POS_TAHSILAT | CEK_CIKIS | CEK_TAHSIL | NAKIT_CIKIS | OPERASYONEL | FATURASIZ
  katman         String   // RESMI | OPERASYONEL
  kaynakVarlikId String?
  hedefVarlikId  String?
  ortakId        String?
  sirketId       Int?
  sirketAdi      String?
  subeId         String?
  tutar          Float
  paraBirimi     String   @default("TRY")
  odemeYontemi   String?  // NAKIT | HAVALE | EFT | KART | CEK | DBS
  aciklama       String?
  evrakNo        String?
  odooFaturaId   Int?
  onaylayan      String?
  olusturan      String?
  iptalEdildi    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  kaynakVarlik FinansalVarlik? @relation("KaynakVarlik", fields: [kaynakVarlikId], references: [id])
  hedefVarlik  FinansalVarlik? @relation("HedefVarlik", fields: [hedefVarlikId], references: [id])
  ortak        Ortak?          @relation(fields: [ortakId], references: [id])
}

// ── ORTAK CARİ ────────────────────────────────────────────────────
model OrtakCari {
  id        String   @id @default(cuid())
  ortakId   String
  sirketId  Int
  sirketAdi String?
  tarih     DateTime @default(now())
  tip       String   // ALACAK | BORC
  tutar     Float
  aciklama  String?
  odendi    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── ŞİRKETLER ARASI CARİ ─────────────────────────────────────────
model SirketCari {
  id            String   @id @default(cuid())
  verenSirketId Int
  alanSirketId  Int
  verenAdi      String?
  alanAdi       String?
  tarih         DateTime @default(now())
  tutar         Float
  aciklama      String?
  odendi        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── PERSONEL ──────────────────────────────────────────────────────
model Personel {
  id              String   @id @default(cuid())
  ad              String
  soyad           String
  telefon         String?
  email           String?
  pozisyon        String   // MUDUR | SATIS | KASIYER | TEKNIK | DIGER
  subeId          String?
  subeAdi         String?
  sirketId        Int?
  sirketAdi       String?
  bolgeId         String?
  maas            Float    @default(0)
  aylikHedef      Float    @default(0)
  aktif           Boolean  @default(true)
  pdksId          String?  // Patron PDKS personel ID
  userId          String?  @unique // User.id FK
  odooEmployeeId  Int?      // hr.employee.id
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation("PersonelUserLink", fields: [userId], references: [id])
  linkedUser      User?    @relation("UserPersonelLink")
  primKazanimlari PrimKazanim[]
  belgeler        PersonelBelge[]
}

model PersonelBelge {
  id          String    @id @default(cuid())
  personelId  String
  tip         String    // IS_SOZLESMESI | SGK_GIRIS | MAAS_BORDROSU | KIMLIK | IKAMETGAH | SAGLIK | DIGER
  ad          String
  dosyaAdi    String
  icerik      String    @db.Text
  mimeType    String
  boyut       Int
  yukleyenId  String
  onaylandi   Boolean   @default(false)
  onaylayanId String?
  onayTarihi  DateTime?
  notlar      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  personel    Personel  @relation(fields: [personelId], references: [id])
}

// ── PRİM KURALI ───────────────────────────────────────────────────
model PrimKural {
  id            String   @id @default(cuid())
  ad            String
  tip           String   // BIREYSEL | MAGAZA | BOLGESEL
  kapsam        String   // GENEL_SATIS | URUN_KATEGORI | BELIRLI_URUN
  donem         String   // AYLIK | HAFTALIK | GUNLUK
  hedefTutar    Float?   // Satış hedefi (TL)
  hedefAdet     Int?     // Satış adedi hedefi
  primOrani     Float?   // % oran (hedef aşımının yüzdesi)
  primSabit     Float?   // Sabit prim tutarı
  kategoriId    String?  // Ürün kategorisi (kapsam=URUN_KATEGORI ise)
  kategoriAdi   String?
  subeId        String?  // Mağaza bazlı kural ise
  subeAdi       String?
  bolgeId       String?  // Bölgesel kural ise
  sirketId      Int?
  pozisyonlar   String?  // JSON: [{"pozisyon":"MUDUR","oran":0.4},{"pozisyon":"SATIS","oran":0.3}]
  aktif         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  kazanimlar    PrimKazanim[]
}

// ── PRİM KAZANIM ──────────────────────────────────────────────────
model PrimKazanim {
  id             String    @id @default(cuid())
  personelId     String
  primKuralId    String
  donemBaslangic DateTime
  donemBitis     DateTime
  hedef          Float
  gerceklesen    Float
  primTutari     Float
  odendi         Boolean   @default(false)
  odemeTarihi    DateTime?
  notlar         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  personel       Personel  @relation(fields: [personelId], references: [id])
  primKural      PrimKural @relation(fields: [primKuralId], references: [id])
}

// ── BÖLGE ────────────────────────────────────────────────────────
model Bolge {
  id        String   @id @default(cuid())
  ad        String
  mudurId   String?
  subeler   String?  // JSON: ["GVN1","GVN3","GVN4"]
  sirketId  Int?
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── ÖZEL SİPARİŞ ─────────────────────────────────────────────────
model OzelSiparis {
  id                String   @id @default(cuid())

  // Müşteri bilgileri
  musteriAdi        String
  musteriTelefon    String?
  musteriId         String?  // POS müşteri ID

  // Satış bağlantısı
  satisSiparisId    String?  // POS satış siparişi ID
  subeId            String?
  subeAdi           String?
  sirketId          Int?

  // Ürün bilgileri
  tip               String   // RECETELI | STANDART
  urunAdi           String
  urunKodu          String?
  miktar            Int      @default(1)

  // Reçete bilgileri (tip=RECETELI ise)
  sagSph            Float?
  sagCyl            Float?
  sagAks            Float?
  sagAdd            Float?
  sagPd             Float?
  solSph            Float?
  solCyl            Float?
  solAks            Float?
  solAdd            Float?
  solPd             Float?
  camTipi           String?  // TEK_ODAKLI | PROGRESIF | BIFOCAL
  camIndeksi        String?  // 1.50 | 1.60 | 1.67 | 1.74
  kaplama           String?  // AR | BLUE_CUT | FOTOKROMIK | SEFFAF
  cerceveBilgisi    String?

  // Tedarikçi bilgileri
  tedarikciId       Int?     // Odoo partner ID
  tedarikciAdi      String?
  tedarikciSiparisNo String?

  // Fiyat bilgileri
  tahminiMaliyet    Float?
  satisFiyati       Float?

  // Durum takibi
  durum             String   @default("BEKLIYOR")
  // BEKLIYOR | TEDARIKCIE_GONDERILDI | URETIMDE | KARGODA | TESLIM_ALINDI | MUSTERIYE_TESLIM | IPTAL

  notlar            String?
  olcumBilgisi      Json?    // LensOrderMeasurement[]
  tahminiGelisTarihi DateTime?
  gercekGelisTarihi  DateTime?
  teslimTarihi      DateTime?

  olusturanKullanici String?

  firmaUrunu        String?
  satisTemsilcisi   String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ── BEKLEYEN FATURA ───────────────────────────────────────────────
model BekleyenFatura {
  id              String    @id @default(cuid())
  girisTipi       String    // FATURA_SONRA | IRSALIYELI | FATURASIZ | UYUMSOFT_GELEN
  tedarikciAdi    String?
  tedarikciId     Int?
  irsaliyeNo      String?
  uyumsoftNo      String?   // Uyumsoft fatura numarası (ör: GVN/2026/000123)
  uyumsoftEttn    String?   @unique // Gelen e-fatura DocumentId / UUID
  uyumsoftVeri    String?   // JSON: Uyumsoft fatura özeti + kalemler
  uyumsoftDurum   String?   // Approved, IsNew vb.
  hedefDepo       String?   @default("ANADEPO")
  tedarikciIrsaliyeNo String? // Tedarikçinin irsaliye numarası
  aciklama        String?
  sirketId        Int?
  sirketAdi       String?
  subeId          String?
  subeAdi         String?
  kalemler        String?   // JSON: [{urunAdi, miktar, birimFiyat, lotNo}]
  odooPickingId   Int?      // Odoo stock.picking id
  odooPickingName String?   // ör: ADESE/IN/00001
  odooFaturaId    Int?      // Eşleşen Odoo vendor bill id
  odooFaturaNo    String?   // ör: BILL/2026/00001
  tahminiTarih    DateTime?
  eslesmeTarihi   DateTime?
  durum           String    @default("BEKLIYOR") // BEKLIYOR | KISMI | ESLESTI | IPTAL
  notlar          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([girisTipi, durum])
}

enum WarrantyStatus {
  OPEN
  SENT_TO_SUPPLIER
  WAITING_RESPONSE
  IN_RETURN_PROCESS
  RESOLVED
  OUT_OF_WARRANTY
}

enum WarrantyResult {
  PENDING
  NEW_PRODUCT
  PART_FREE
  PART_PAID
  POINTS_LOADED
  OUT_OF_WARRANTY_FEE
  OUT_OF_WARRANTY_REJECTED
}

enum WarrantyType {
  CUSTOMER_WARRANTY
  STOCK_WARRANTY
  SATISFACTION_RETURN
  EXCESS_ORDER_RETURN
}

enum WarrantyExpectedOutcome {
  UNKNOWN
  NEW_PRODUCT
  REPAIR
  POINTS
  REFUND
}

model WarrantyClaim {
  id              String    @id @default(uuid())
  claimNo         String    @unique
  status          WarrantyStatus @default(OPEN)
  result          WarrantyResult @default(PENDING)
  type            WarrantyType
  expectedOutcome WarrantyExpectedOutcome @default(UNKNOWN)

  saleId          String?
  sale            Sale?     @relation(fields: [saleId], references: [id])
  saleItemId      String?
  saleItem        SaleItem? @relation(fields: [saleItemId], references: [id])

  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])

  branchId        String?
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])

  productName     String?
  productCategory String?
  odooCategoryId  Int?
  lotNo           String?
  barcode         String?
  internalRef     String?
  supplierName    String?

  chainJson       String?

  problemDesc     String?
  supplierNote    String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages        WarrantyMessage[]
}

model WarrantyMessage {
  id        String   @id @default(uuid())
  claimId   String
  claim     WarrantyClaim @relation(fields: [claimId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  message   String
  createdAt DateTime @default(now())
}

model UtsSube {
  id          String    @id @default(cuid())
  branchId    String    @unique
  kurumNo     String?
  token       String?
  ortam       String    @default("canli") // test | canli
  aktif       Boolean   @default(false)
  sonKontrol  DateTime?
  branch      Branch    @relation(fields: [branchId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model UtsDisFirma {
  id             String                @id @default(cuid())
  ad             String
  vkn            String?
  kurumNo        String?
  adres          String?
  telefon        String?
  email          String?
  notlar         String?
  odooPartnerId  Int?
  aktif          Boolean               @default(true)
  lokasyonlar    UtsDisFirmaLokasyon[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model UtsDisFirmaLokasyon {
  id         String      @id @default(cuid())
  firmaId    String
  ad         String
  kurumNo    String?
  varsayilan Boolean     @default(false)
  firma      UtsDisFirma @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
}

model UtsBildirim {
  id             String   @id @default(cuid())
  tip            String   // ALMA | VERME | TUKETICIYE_VERME | TANIMSIZ_YERE_VERME | TUKETICIDEN_IADE | HEK_ZAYIAT
  durum          String   @default("BEKLIYOR") // BEKLIYOR | GONDERILDI | HATA | IPTAL
  branchId       String
  karsiKurumNo   String?
  karsiVkn       String?
  karsiAd        String?
  belgeNo        String?
  payload        Json
  utsBildirimId  String?
  hataDetay      String?
  gonderimZamani DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch   @relation(fields: [branchId], references: [id])
  kalemler       UtsBildirimKalem[]
}

model UtsBildirimKalem {
  id         String      @id @default(cuid())
  bildirimId String
  barkod     String
  seriNo     String?
  lotNo      String?
  adet       Int         @default(1)
  bildirim   UtsBildirim @relation(fields: [bildirimId], references: [id], onDelete: Cascade)
}

model Fatura {
  id           String    @id @default(cuid())
  faturaNo     String    @unique
  uuid         String?
  satisId      String?
  transferId   String?
  sube         String
  aliciVkn     String
  aliciAdi     String
  tutar        Float
  durum        String    @default("GONDERILDI") // GONDERILDI, HATA, IPTAL
  profileId    String    @default("EARSIVFATURA") // TEMELFATURA / EARSIVFATURA
  hata         String?
  gonderilenAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([sube])
  @@index([satisId])
  @@index([transferId])
  @@index([durum])
}

model FaturaKuyruk {
  id           String    @id @default(cuid())
  satisId      String?
  transferId   String?
  faturaNo     String
  faturaData   String    // JSON
  durum        String    @default("BEKLIYOR") // BEKLIYOR, GONDERILDI, BASARISIZ
  deneme       Int       @default(0)
  hata         String?
  gonderilenAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([durum])
}

model ChatbotKullanim {
  id             String   @id @default(cuid())
  userId         String   @unique
  kullanimSayisi Int      @default(0)
  ilkKullanimAt  DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
