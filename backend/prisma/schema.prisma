  @@index([siparisId])
  @@index([karekod])
}

// ── BEKLEYEN FATURA ───────────────────────────────────────────────
model BekleyenFatura {
  id              String    @id @default(cuid())
  girisTipi       String    // FATURA_SONRA | IRSALIYELI | FATURASIZ | UYUMSOFT_GELEN
  tedarikciAdi    String?
  tedarikciId     Int?
  irsaliyeNo      String?
  uyumsoftNo      String?   // Uyumsoft fatura numarası (ör: GVN/2026/000123)
  uyumsoftEttn    String?   @unique // Gelen e-fatura DocumentId / UUID
  uyumsoftVeri    String?   // JSON: Uyumsoft fatura özeti + kalemler
  uyumsoftDurum   String?   // Approved, IsNew vb.
  uyumsoftSirketId String?  @default("ng") // Uyumsoft hesap kodu: ng | adese | potential
  hedefDepo       String?   @default("ANADEPO")
  tedarikciIrsaliyeNo String? // Tedarikçinin irsaliye numarası
  aciklama        String?
  sirketId        Int?
  sirketAdi       String?
  subeId          String?
  subeAdi         String?
  kalemler        String?   // JSON: [{urunAdi, miktar, birimFiyat, lotNo}]
  odooPickingId   Int?      // Odoo stock.picking id
  odooPickingName String?   // ör: ADESE/IN/00001
  odooFaturaId    Int?      // Eşleşen Odoo vendor bill id
  odooFaturaNo    String?   // ör: BILL/2026/00001
  tahminiTarih    DateTime?
  eslesmeTarihi   DateTime?
  durum           String    @default("BEKLIYOR") // BEKLIYOR | KISMI | ESLESTI | IPTAL
  notlar          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([girisTipi, durum])
  @@index([uyumsoftSirketId])
}

// Uyumsoft gelen fatura — tedarikçi bazlı sütun eşleştirme profili
