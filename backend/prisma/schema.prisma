generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String?
  username   String   @unique
  pin        String // bcrypt hash
  role       Role
  branchId   String
  isActive   Boolean  @default(true)
  canWorkAtolye Boolean @default(false)
  odooEmployeeId  Int?      // hr.employee.id
  personelId      String?   @unique // Personel.id FK
  ekYetkiler      String[]  @default([])
  createdAt  DateTime @default(now())
  branch     Branch   @relation(fields: [branchId], references: [id])
  personel        Personel? @relation("UserPersonelLink", fields: [personelId], references: [id])
  personelByUser  Personel? @relation("PersonelUserLink")
  sales      Sale[]
  shifts     Shift[]
  warrantyClaims   WarrantyClaim[]
  warrantyMessages WarrantyMessage[]
  gorevliler           Gorevli[] @relation("GorevliUser")
  atadigiGorevliler    Gorevli[] @relation("GorevliAtayan")
  yedekSorumluSubeler  Branch[]  @relation("BranchYedekSorumlu")
}

enum Role {
  SALES_STAFF
  STORE_MANAGER
  WAREHOUSE_MANAGER
  REGIONAL_MANAGER
  ACCOUNTANT
  ADMIN
  WORKSHOP_STAFF
}

model Branch {
  id              String    @id @default(uuid())
  name            String
  code            String    @unique
  isActive        Boolean   @default(true)
  hasAtolye       Boolean   @default(false)
  sirketId        Int?
  sirketAdi       String?
  vkn             String?
  odooLocationId  Int?
  pdksPlaceId     Int?
  uyumsoftUser    String?
  uyumsoftPass    String?
  adres           String?
  il              String?
  ilce            String?
  telefon         String?
  yedekSorumluId  String?
  users           User[]
  yedekSorumlu    User?     @relation("BranchYedekSorumlu", fields: [yedekSorumluId], references: [id])
  gorevliler      Gorevli[]
  utsSube         UtsSube?
  utsBildirimler  UtsBildirim[]
}

model Gorevli {
  id          String   @id @default(cuid())
  branchId    String
  userId      String
  atayaUserId String
  tarih       DateTime @db.Date
  baslangic   String?
  bitis       String?
  notlar      String?
  aktif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  branch      Branch   @relation(fields: [branchId], references: [id])
  user        User     @relation("GorevliUser", fields: [userId], references: [id])
  atayan      User     @relation("GorevliAtayan", fields: [atayaUserId], references: [id])
}

model Customer {
  id               String    @id @default(uuid())
  name             String
  phone            String    @unique
  note             String?
  adres            String?
  il               String?
  ilce             String?
  // V2 alanları — şimdi ekle, V2'de aktive et
  identityNo       String?
  birthDate        DateTime?
  sgkType          String?
  medulaNo         String?
  doctorName       String?
  prescriptionNo   String?
  hasPresciption   Boolean   @default(false)
  // Daimi
  far_r_pd         String?
  far_r_sph        String?
  far_r_cyl        String?
  far_r_aks        String?
  far_r_diagnosis  String?
  far_l_pd         String?
  far_l_sph        String?
  far_l_cyl        String?
  far_l_aks        String?
  far_l_diagnosis  String?
  // Yakın
  near_r_pd        String?
  near_r_sph       String?
  near_r_cyl       String?
  near_r_aks       String?
  near_r_diagnosis String?
  near_l_pd        String?
  near_l_sph       String?
  near_l_cyl       String?
  near_l_aks       String?
  near_l_diagnosis String?
  // Lens
  lens_r_bc        String?
  lens_r_sph       String?
  lens_r_cyl       String?
  lens_r_aks       String?
  lens_r_add       String?
  lens_l_bc        String?
  lens_l_sph       String?
  lens_l_cyl       String?
  lens_l_aks       String?
  lens_l_add       String?
  // E-Reçete
  eRx_no           String?
  eRx_date         String?
  eRx_hospital     String?
  eRx_doctor       String?
  eRx_diagnosis    String?
  odooPartnerId    Int?
  legacyCustomerId String?
  createdAt        DateTime  @default(now())
  sales            Sale[]
  prescriptions    CustomerPrescription[]
  warrantyClaims   WarrantyClaim[]
}

model CustomerPrescription {
  id            String   @id @default(uuid())
  customerId    String
  date          DateTime @default(now())
  source        String   @default("MANUAL")

  far_r_pd   String?
  far_r_sph  String?
  far_r_cyl  String?
  far_r_aks  String?
  far_r_note String?
  far_l_pd   String?
  far_l_sph  String?
  far_l_cyl  String?
  far_l_aks  String?
  far_l_note String?

  near_r_pd   String?
  near_r_sph  String?
  near_r_cyl  String?
  near_r_aks  String?
  near_r_note String?
  near_l_pd   String?
  near_l_sph  String?
  near_l_cyl  String?
  near_l_aks  String?
  near_l_note String?

  lens_r_bc   String?
  lens_r_sph  String?
  lens_r_cyl  String?
  lens_r_aks  String?
  lens_r_add  String?
  lens_r_note String?
  lens_l_bc   String?
  lens_l_sph  String?
  lens_l_cyl  String?
  lens_l_aks  String?
  lens_l_add  String?
  lens_l_note String?

  eRx_no        String?
  eRx_date      String?
  eRx_hospital  String?
  eRx_doctor    String?
  eRx_diagnosis String?

  createdAt DateTime @default(now())
  customer  Customer @relation(fields: [customerId], references: [id])
}

model Product {
  id          String          @id @default(uuid())
  barcode     String?         @unique
  name        String
  productType ProductType     // READY veya PRESCRIBED
  category    ProductCategory // Ana kategori
  subCategory String?         // Alt kategori (serbest metin)
  group       ProductGroup?   // Fiyat/rapor grubu
  price       Decimal         @db.Decimal(10, 2)
  taxRate     Decimal         @db.Decimal(5, 2) @default(20)
  brand       String?         // Marka
  model       String?         // Model
  isActive    Boolean         @default(true)
  odooId      String?
  referansNo  String?         @unique
  saleItems   SaleItem[]
}

enum ProductType {
  READY
  PRESCRIBED
}

enum ProductCategory {
  SUNGLASSES_READY
  OPTICAL_FRAME_READY
  CONTACT_LENS_READY
  SOLUTION
  ACCESSORY

  SUNGLASSES_RX
  OPTICAL_FRAME_RX
  LENS_RX
  CONTACT_LENS_RX
}

enum ProductGroup {
  UPPER
  UPPER_MID
  MID
  LOWER

  PROGRESSIVE_UPPER
  PROGRESSIVE_UPPER_MID
  PROGRESSIVE_MID
  PROGRESSIVE_LOWER
  OFFICE_LENS
  SPECIAL_LENS
  SINGLE_CUSTOM
  SINGLE_NON_STOCK
  SINGLE_STOCK

  CONTACT_SPH
  CONTACT_DAILY
  CONTACT_TORIC
  CONTACT_MULTIFOCAL
  CONTACT_COLORED_RX
}

model Sale {
  id                 String     @id @default(uuid())
  customerId         String
  userId             String // satışı yapan personel
  branchId           String
  shiftId            String
  grossTotal         Decimal    @db.Decimal(10, 2)
  discountTotal      Decimal    @db.Decimal(10, 2) @default(0)
  netTotal           Decimal    @db.Decimal(10, 2)
  taxTotal           Decimal    @db.Decimal(10, 2)
  status             SaleStatus @default(DRAFT)
  // VOID alanları
  voidReason         String?
  voidUserId         String?
  voidAt             DateTime?
  // V2 SGK alanları — şimdi ekle
  prescriptionAmount Decimal?   @db.Decimal(10, 2)
  sgkAmount          Decimal?   @db.Decimal(10, 2)
  // Odoo sync
  odooSaleId         String?
  syncStatus         SyncStatus @default(PENDING)
  syncError          String?
  odooSaleOrderId    Int?
  odooSynced         Boolean    @default(false)
  odooSyncError      String?
  odooCancelled      Boolean    @default(false)
  odooCancelError    String?
  eFaturaId          String?
  eFaturaDurum       String?    // GONDERILDI, BEKLIYOR, HATA
  referansNo         String?    @unique
  draftMeta          Json?      // taslak adım/fiyat/ödeme/ölçüm snapshot
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  shift    Shift    @relation(fields: [shiftId], references: [id])
  items    SaleItem[]
  payments Payment[]
  warrantyClaims WarrantyClaim[]
}

enum SaleStatus {
  DRAFT
  PAID
  ORDERED
  IN_LAB
  READY
  DELIVERED
  VOID
}

enum SyncStatus {
  PENDING
  SYNCED
  ERROR
  CONFLICT
}

model SaleItem {
  id              String  @id @default(uuid())
  saleId          String
  productId       String
  odooCategoryId  Int?
  odooProductId   String?
  odooProductName String?
  lotNo           String?
  qty             Int     @default(1)
  unitPrice       Decimal @db.Decimal(10, 2)
  discount        Decimal @db.Decimal(10, 2) @default(0)
  taxRate         Decimal? @db.Decimal(5, 2)
  taxAmount       Decimal @db.Decimal(10, 2)
  lineTotal       Decimal @db.Decimal(10, 2)

  linkedItemId String?
  linkType     LinkType?
  pairedItemId String?

  prescription Prescription?
  frames       Frame[]

  status ItemStatus @default(PENDING)
  deliveryDate  DateTime?
  lensOrderMeasurement Json?

  atolyeBranchId    String?
  sentToLabAt       DateTime?
  sentToLabByUserId String?

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  warrantyClaims WarrantyClaim[]
}

// ── ATÖLYE LAB OLAYI (WarrantyClaim'den ayrı) ────────────────────
model LabIncident {
  id               String   @id @default(cuid())
  saleItemId       String
  atolyeBranchId   String
  reportedByUserId String
  incidentType     String   // LENS_BROKEN | FRAME_BROKEN | MEASUREMENT_SHIFT
  note             String?
  resolutionType   String?  // TRANSFER | OZEL_SIPARIS | NONE
  ozelSiparisId    String?
  transferRef      String?
  createdAt        DateTime @default(now())

  @@index([saleItemId])
  @@index([atolyeBranchId])
}

enum LinkType {
  FRAME_LENS
  CUSTOMER_FRAME
}

enum ItemStatus {
  PENDING
  ORDERED
  IN_LAB
  READY
  DELIVERED
  VOID
}

model Prescription {
  id               String             @id @default(uuid())
  saleItemId       String             @unique
  prescriptionType PrescriptionType

  r_pd   Decimal? @db.Decimal(5, 2)
  r_sph  Decimal? @db.Decimal(5, 2)
  r_cyl  Decimal? @db.Decimal(5, 2)
  r_aks  Int?
  r_add  Decimal? @db.Decimal(5, 2)

  l_pd   Decimal? @db.Decimal(5, 2)
  l_sph  Decimal? @db.Decimal(5, 2)
  l_cyl  Decimal? @db.Decimal(5, 2)
  l_aks  Int?
  l_add  Decimal? @db.Decimal(5, 2)

  near_r_sph Decimal? @db.Decimal(5, 2)
  near_l_sph Decimal? @db.Decimal(5, 2)

  lens_r_sph   Decimal? @db.Decimal(5, 2)
  lens_r_cyl   Decimal? @db.Decimal(5, 2)
  lens_r_aks   Int?
  lens_r_bc    Decimal? @db.Decimal(5, 2)
  lens_r_dia   Decimal? @db.Decimal(5, 2)
  lens_r_add   Decimal? @db.Decimal(5, 2)
  lens_r_color String?
  lens_r_brand String?

  lens_l_sph   Decimal? @db.Decimal(5, 2)
  lens_l_cyl   Decimal? @db.Decimal(5, 2)
  lens_l_aks   Int?
  lens_l_bc    Decimal? @db.Decimal(5, 2)
  lens_l_dia   Decimal? @db.Decimal(5, 2)
  lens_l_add   Decimal? @db.Decimal(5, 2)
  lens_l_color String?
  lens_l_brand String?

  solution    String?
  solutionQty Int?

  prescriptionSource PrescriptionSource @default(MANUAL)
  doctorName         String?
  prescriptionDate   DateTime?
  eReceteCode        String?

  saleItem SaleItem @relation(fields: [saleItemId], references: [id])
}

enum PrescriptionType {
  SINGLE
  PROGRESSIVE
  BIFOCAL
  SUNGLASSES
  CONTACT_LENS
}

enum PrescriptionSource {
  MANUAL
  DOCTOR_RX
  OLD_GLASSES
}

model Frame {
  id        String @id @default(uuid())
  saleItemId String
  sortOrder Int    @default(1)

  barcode String?
  brand   String?
  model   String?

  h          Decimal? @db.Decimal(5, 2)
  cap        Decimal? @db.Decimal(5, 2)
  vertex     Decimal? @db.Decimal(5, 2)
  pantos     Decimal? @db.Decimal(5, 2)
  frameAngle Decimal? @db.Decimal(5, 2)

  saleItem SaleItem @relation(fields: [saleItemId], references: [id])
}
model Payment {
  id               String      @id @default(uuid())
  saleId           String
  paymentType      PaymentType
  bankId           String? // sadece CARD için
  posDeviceId      String? // sadece CARD için
  installment      Int? // taksit sayısı
  grossAmount      Decimal     @db.Decimal(10, 2)
  commissionRate   Decimal?    @db.Decimal(5, 4) // örn: 0.0400
  commissionAmount Decimal?    @db.Decimal(10, 2)
  netAmount        Decimal     @db.Decimal(10, 2)
  createdAt        DateTime    @default(now())
  sale             Sale        @relation(fields: [saleId], references: [id])
}

enum PaymentType {
  CASH
  CARD
  TRANSFER
  OPEN_ACCOUNT
  SGK
  VAKIF
}

model Bank {
  id         String              @id @default(uuid())
  name       String
  isActive   Boolean             @default(true)
  posDevices PosDevice[]
  rates      InstallmentRate[]
}

model PosDevice {
  id       String  @id @default(uuid())
  bankId   String
  branchId String
  name     String
  isActive Boolean @default(true)
  bank     Bank    @relation(fields: [bankId], references: [id])
}

model InstallmentRate {
  id             String    @id @default(uuid())
  bankId         String
  installment    Int // 1, 3, 6, 9, 12
  commissionRate Decimal   @db.Decimal(5, 4) // örn: 0.0400 = %4
  startDate      DateTime
  endDate        DateTime?
  bank           Bank      @relation(fields: [bankId], references: [id])
}

model CashMovement {
  id          String           @id @default(uuid())
  branchId    String
  shiftId     String
  userId      String
  type        CashMovementType
  amount      Decimal          @db.Decimal(10, 2)
  description String
  createdAt   DateTime         @default(now())
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
  ADVANCE
  TRANSFER_OUT
}

model Shift {
  id           String      @id @default(uuid())
  branchId     String
  userId       String // vardiyayı açan kişi
  openCash     Decimal     @db.Decimal(10, 2)
  closeCash    Decimal?    @db.Decimal(10, 2)
  physicalCash Decimal?    @db.Decimal(10, 2) // gün sonu sayılan
  diff         Decimal?    @db.Decimal(10, 2) // fiziki - hesaplanan
  diffReason   String?
  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  user  User   @relation(fields: [userId], references: [id])
  sales Sale[]
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model SyncLog {
  id        String   @id @default(uuid())
  saleId    String?
  action    String // create_order, create_payment, stock_move
  status    String // success, error, conflict
  payload   Json
  response  Json?
  error     String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  payload   Json
  createdAt DateTime @default(now())
}

enum CampaignType {
  KASA
  NAKIT_ORAN
  IKI_AL_BIR_ODE
  URUN_BAZLI
  COMBO
  FORMUL
}

enum CampaignScope {
  ALL
  CATEGORY
  PRODUCT
  CUSTOMER_SEGMENT
}

model Campaign {
  id          String         @id @default(uuid())
  name        String
  description String?
  type        CampaignType
  scope       CampaignScope  @default(ALL)
  scopeValue  String?
  discountPct  Decimal?  @db.Decimal(5, 2)
  discountTL   Decimal?  @db.Decimal(10, 2)
  minBasket    Decimal?  @db.Decimal(10, 2)
  minQty       Int?      @default(0)
  formulMultiplier Decimal? @db.Decimal(8, 4)
  formulExtra      Decimal? @db.Decimal(10, 2)
  formulMargin     Decimal? @db.Decimal(5, 2)
  comboConfig  Json?
  startDate    DateTime?
  endDate      DateTime?
  priority     Int       @default(10)
  autoApply    Boolean   @default(true)
  manualAlso   Boolean   @default(false)
  oodooPricelistId Int?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  branchOverrides CampaignBranchOverride[]
  logs            CampaignLog[]
}

model CampaignBranchOverride {
  id           String    @id @default(uuid())
  campaignId   String
  branchId     String
  branchCode   String
  isActive     Boolean?
  discountPct  Decimal?  @db.Decimal(5, 2)
  discountTL   Decimal?  @db.Decimal(10, 2)
  startDate    DateTime?
  endDate      DateTime?
  autoApply    Boolean?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@unique([campaignId, branchId])
}

model CampaignLog {
  id           String   @id @default(uuid())
  campaignId   String
  saleId       String
  branchId     String
  branchCode   String
  userId       String
  discountTRY  Decimal  @db.Decimal(10, 2)
  appliedAt    DateTime @default(now())
  campaign     Campaign @relation(fields: [campaignId], references: [id])
}

// ── ORTAK ─────────────────────────────────────────────────────────
model Ortak {
  id         String   @id @default(cuid())
  ad         String
  soyad      String?
  telefon    String?
  email      String?
  aktif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  hareketler FinansHareket[]
  varliklar  FinansalVarlik[] @relation("OrtakVarlik")
}

// ── FİNANSAL VARLIK ───────────────────────────────────────────────
model FinansalVarlik {
  id              String   @id @default(cuid())
  ad              String
  tip             String   // BANKA | KASA | POS | ORTAK | CEK | DBS | EK_HESAP
  katman          String   // RESMI | OPERASYONEL
  sirketId        Int?     // Odoo company id
  sirketAdi       String?
  subeId          String?  // Mağaza/şube
  subeAdi         String?
  para_birimi     String   @default("TRY")
  aktif           Boolean  @default(true)
  aciklama        String?
  odooHesapId     Int?     // Odoo account.account id (varsa)
  ortakId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  hareketler      FinansHareket[] @relation("KaynakVarlik")
  hedefHareketler FinansHareket[] @relation("HedefVarlik")
  ortak           Ortak?          @relation("OrtakVarlik", fields: [ortakId], references: [id])
}

// ── FİNANS HAREKETİ ───────────────────────────────────────────────
model FinansHareket {
  id             String   @id @default(cuid())
  tarih          DateTime @default(now())
  tip            String   // TAHSILAT | ODEME | VIRMAN | ORTAK_DESTEGI | ORTAK_ODEME | SIRKET_TRANSFER | POS_TAHSILAT | CEK_CIKIS | CEK_TAHSIL | NAKIT_CIKIS | OPERASYONEL | FATURASIZ
  katman         String   // RESMI | OPERASYONEL
  kaynakVarlikId String?
  hedefVarlikId  String?
  ortakId        String?
  sirketId       Int?
  sirketAdi      String?
  subeId         String?
  tutar          Float
  paraBirimi     String   @default("TRY")
  odemeYontemi   String?  // NAKIT | HAVALE | EFT | KART | CEK | DBS
  aciklama       String?
  evrakNo        String?
  odooFaturaId   Int?
  onaylayan      String?
  olusturan      String?
  iptalEdildi    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  kaynakVarlik FinansalVarlik? @relation("KaynakVarlik", fields: [kaynakVarlikId], references: [id])
  hedefVarlik  FinansalVarlik? @relation("HedefVarlik", fields: [hedefVarlikId], references: [id])
  ortak        Ortak?          @relation(fields: [ortakId], references: [id])
}

// ── ORTAK CARİ ────────────────────────────────────────────────────
model OrtakCari {
  id        String   @id @default(cuid())
  ortakId   String
  sirketId  Int
  sirketAdi String?
  tarih     DateTime @default(now())
  tip       String   // ALACAK | BORC
  tutar     Float
  aciklama  String?
  odendi    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── ŞİRKETLER ARASI CARİ ─────────────────────────────────────────
model SirketCari {
  id            String   @id @default(cuid())
  verenSirketId Int
  alanSirketId  Int
  verenAdi      String?
  alanAdi       String?
  tarih         DateTime @default(now())
  tutar         Float
  aciklama      String?
  odendi        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── PERSONEL ──────────────────────────────────────────────────────
model Personel {
  id              String   @id @default(cuid())
  ad              String
  soyad           String
  telefon         String?
  email           String?
  pozisyon        String   // MUDUR | SATIS | KASIYER | TEKNIK | DIGER
  subeId          String?
  subeAdi         String?
  sirketId        Int?
  sirketAdi       String?
  bolgeId         String?
  maas            Float    @default(0)
  aylikHedef      Float    @default(0)
  aktif           Boolean  @default(true)
  pdksId          String?  // Patron PDKS personel ID
  userId          String?  @unique // User.id FK
  odooEmployeeId  Int?      // hr.employee.id
  ekYetkiler      String[]  @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation("PersonelUserLink", fields: [userId], references: [id])
  linkedUser      User?    @relation("UserPersonelLink")
  primKazanimlari PrimKazanim[]
  belgeler        PersonelBelge[]
  ozgecmis        PersonelOzgecmis?
  sertifikalar    PersonelSertifika[]
  sozlesmeler     PersonelSozlesme[]
  bordrolar       PersonelBordro[]
  hastalikRaporlari PersonelHastalikRaporu[]
  belgeLoglari    PersonelBelgeLog[]
}

model PersonelBelge {
  id               String    @id @default(cuid())
  personelId       String
  tip              String    // bkz PersonelBelgeKategorisi.kod — IS_SOZLESMESI | SGK_GIRIS | MAAS_BORDROSU | KIMLIK | IKAMETGAH | SAGLIK | DIGER ...
  ad               String
  dosyaAdi         String
  icerik           String    @db.Text
  mimeType         String
  boyut            Int
  yukleyenId       String
